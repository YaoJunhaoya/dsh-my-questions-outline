{
  "name": "dsh-my-questions-outline",
  "version": "0.1.7",
  "description": "DeepSeek Harness (DSH) 插件：在页面右侧显示「我的提问大纲」侧边栏，自动收集当前会话里我提出的问题与插话，支持本地持久化、点击平滑滚动定位并高亮对应消息。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-username>/dsh-my-questions-outline.git"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "outline",
    "questions",
    "sidebar",
    "toc"
  ],
  "license": "MIT"
}
